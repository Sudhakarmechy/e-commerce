new file mode 100644
index 0000000000000000000000000000000000000000..8e41b857cf57fb1832d11da8e5796f64b6c7dfa2
--- /dev/null
+++ b/auth-service/src/main/java/com/marketplace/service/AuthService.java
@@ -0,0 +1,81 @@
+package com.marketplace.service;
+
+import com.marketplace.config.JwtProperties;
+import com.marketplace.dto.AuthResponse;
+import com.marketplace.dto.LoginRequest;
+import com.marketplace.dto.SignupRequest;
+import com.marketplace.dto.TokenValidationResponse;
+import com.marketplace.entity.UserEntity;
+import com.marketplace.exception.ConflictException;
+import com.marketplace.exception.UnauthorizedException;
+import com.marketplace.mapper.AuthMapper;
+import com.marketplace.repository.UserRepository;
+import com.marketplace.util.JwtService;
+import io.jsonwebtoken.Claims;
+import org.springframework.security.crypto.password.PasswordEncoder;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+@Service
+public class AuthService {
+
+    private final UserRepository userRepository;
+    private final PasswordEncoder passwordEncoder;
+    private final JwtService jwtService;
+    private final AuthMapper authMapper;
+    private final JwtProperties jwtProperties;
+
+    public AuthService(UserRepository userRepository,
+                       PasswordEncoder passwordEncoder,
+                       JwtService jwtService,
+                       AuthMapper authMapper,
+                       JwtProperties jwtProperties) {
+        this.userRepository = userRepository;
+        this.passwordEncoder = passwordEncoder;
+        this.jwtService = jwtService;
+        this.authMapper = authMapper;
+        this.jwtProperties = jwtProperties;
+    }
+
+    @Transactional
+    public AuthResponse signup(SignupRequest request) {
+        userRepository.findByEmail(request.email())
+                .ifPresent(user -> {
+                    throw new ConflictException("Email already exists");
+                });
+
+        UserEntity user = new UserEntity();
+        user.setEmail(request.email().toLowerCase());
+        user.setPasswordHash(passwordEncoder.encode(request.password()));
+        user.setRoles(request.roles());
+        user.setTenantId(request.tenantId());
+
+        UserEntity savedUser = userRepository.save(user);
+        String accessToken = jwtService.generateAccessToken(savedUser);
+        return authMapper.toAuthResponse(savedUser, accessToken, jwtProperties.accessTokenExpirySeconds());
+    }
+
+    @Transactional(readOnly = true)
+    public AuthResponse login(LoginRequest request) {
+        UserEntity user = userRepository.findByEmail(request.email().toLowerCase())
+                .orElseThrow(() -> new UnauthorizedException("Invalid credentials"));
+
+        if (!passwordEncoder.matches(request.password(), user.getPasswordHash())) {
+            throw new UnauthorizedException("Invalid credentials");
+        }
+
+        String accessToken = jwtService.generateAccessToken(user);
+        return authMapper.toAuthResponse(user, accessToken, jwtProperties.accessTokenExpirySeconds());
+    }
+
+    public TokenValidationResponse validateToken(String token) {
+        String sanitizedToken = token.replace("Bearer ", "").trim();
+        Claims claims = jwtService.parseToken(sanitizedToken);
+        return new TokenValidationResponse(
+                true,
+                claims.get("userId", String.class),
+                claims.get("role", String.class),
+                claims.get("tenantId", String.class)
+        );
+    }
+}
diff --git a/auth-service/src/main/java/com/marketplace/util/JwtService.java b/auth-service/src/main/java/com/marketplace/util/JwtService.java
new file mode 100644
index 0000000000000000000000000000000000000000..07d3cc92f4d0df083945c25702b0c7f2e1cb812b
--- /dev/null
+++ b/auth-service/src/main/java/com/marketplace/util/JwtService.java
@@ -0,0 +1,68 @@
+package com.marketplace.util;
+
+import com.marketplace.config.JwtProperties;
+import com.marketplace.entity.Role;
+import com.marketplace.entity.UserEntity;
+import com.marketplace.exception.UnauthorizedException;
+import io.jsonwebtoken.Claims;
+import io.jsonwebtoken.Jwts;
+import io.jsonwebtoken.security.Keys;
+import org.springframework.stereotype.Component;
+
+import javax.crypto.SecretKey;
+import java.nio.charset.StandardCharsets;
+import java.time.Instant;
+import java.util.Date;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+import java.util.stream.Collectors;
+
+@Component
+public class JwtService {
+
+    private final JwtProperties jwtProperties;
+    private final SecretKey key;
+
+    public JwtService(JwtProperties jwtProperties) {
+        this.jwtProperties = jwtProperties;
+        this.key = Keys.hmacShaKeyFor(jwtProperties.secret().getBytes(StandardCharsets.UTF_8));
+    }
+
+    public String generateAccessToken(UserEntity user) {
+        Instant now = Instant.now();
+        Instant expiry = now.plusSeconds(jwtProperties.accessTokenExpirySeconds());
+
+        Map<String, Object> claims = Map.of(
+                "userId", user.getId().toString(),
+                "role", firstRole(user.getRoles()),
+                "tenantId", user.getTenantId()
+        );
+
+        return Jwts.builder()
+                .claims(claims)
+                .subject(user.getEmail())
+                .issuer(jwtProperties.issuer())
+                .issuedAt(Date.from(now))
+                .expiration(Date.from(expiry))
+                .signWith(key)
+                .compact();
+    }
+
+    public Claims parseToken(String token) {
+        try {
+            return Jwts.parser()
+                    .verifyWith(key)
+                    .requireIssuer(jwtProperties.issuer())
+                    .build()
+                    .parseSignedClaims(token)
+                    .getPayload();
+        } catch (Exception ex) {
+            throw new UnauthorizedException("Invalid or expired token");
+        }
+    }
+
+    private String firstRole(Set<Role> roles) {
+        return roles.stream().map(Enum::name).sorted().collect(Collectors.joining(","));
+    }
+}
