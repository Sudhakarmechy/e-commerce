+package com.marketplace.controller;
+
+import com.marketplace.dto.VendorLocationRequest;
+import com.marketplace.dto.VendorLocationResponse;
+import com.marketplace.dto.VendorResponse;
+import com.marketplace.dto.VendorUpsertRequest;
+import com.marketplace.service.VendorService;
+import jakarta.validation.Valid;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+
+import java.util.UUID;
+
+@RestController
+@RequestMapping("/api/v1/vendors")
+public class VendorController {
+
+    private final VendorService vendorService;
+
+    public VendorController(VendorService vendorService) {
+        this.vendorService = vendorService;
+    }
+
+    @GetMapping("/me")
+    public ResponseEntity<VendorResponse> getMyVendor() {
+        return ResponseEntity.ok(vendorService.getMyVendor());
+    }
+
+    @PutMapping("/me")
+    public ResponseEntity<VendorResponse> upsertMyVendor(@Valid @RequestBody VendorUpsertRequest request) {
+        return ResponseEntity.ok(vendorService.upsertMyVendor(request));
+    }
+
+    @GetMapping("/me/location")
+    public ResponseEntity<VendorLocationResponse> getMyVendorLocation() {
+        return ResponseEntity.ok(vendorService.getMyVendorLocation());
+    }
+
+    @PutMapping("/me/location")
+    public ResponseEntity<VendorLocationResponse> upsertMyVendorLocation(@Valid @RequestBody VendorLocationRequest request) {
+        return ResponseEntity.ok(vendorService.upsertMyVendorLocation(request));
+    }
+
+    @DeleteMapping("/me")
+    public ResponseEntity<Void> deactivateMyVendor() {
+        vendorService.deactivateMyVendor();
+        return ResponseEntity.noContent().build();
+    }
+
+    @GetMapping("/{vendorId}")
+    public ResponseEntity<VendorResponse> getVendorById(@PathVariable UUID vendorId) {
+        return ResponseEntity.ok(vendorService.getVendorById(vendorId));
+    }
+}
