+    Optional<PaymentEntity> findByOrderIdAndTenantId(UUID orderId, String tenantId);
+    Optional<PaymentEntity> findByIdAndTenantId(UUID paymentId, String tenantId);
+    List<PaymentEntity> findByTenantIdAndCustomerId(String tenantId, UUID customerId);
