diff --git a/admin-service/src/main/java/com/marketplace/service/AdminService.java b/admin-service/src/main/java/com/marketplace/service/AdminService.java
new file mode 100644
index 0000000000000000000000000000000000000000..9e6c4d6b09a11256fe6f23f54c0aefa8136ee6d6
--- /dev/null
+++ b/admin-service/src/main/java/com/marketplace/service/AdminService.java
@@ -0,0 +1,63 @@
+package com.marketplace.service;
+
+import com.marketplace.dto.AdminAuditResponse;
+import com.marketplace.dto.UserStatusUpdateRequest;
+import com.marketplace.entity.AdminActionType;
+import com.marketplace.entity.AdminAuditEntity;
+import com.marketplace.exception.ForbiddenException;
+import com.marketplace.mapper.AdminMapper;
+import com.marketplace.repository.AdminAuditRepository;
+import com.marketplace.util.AuthContextResolver;
+import com.marketplace.util.AuthenticatedUser;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.util.List;
+import java.util.UUID;
+
+@Service
+public class AdminService {
+    private final AdminAuditRepository adminAuditRepository;
+    private final AdminMapper adminMapper;
+    private final AuthContextResolver authContextResolver;
+
+    public AdminService(AdminAuditRepository adminAuditRepository, AdminMapper adminMapper,
+                        AuthContextResolver authContextResolver) {
+        this.adminAuditRepository = adminAuditRepository;
+        this.adminMapper = adminMapper;
+        this.authContextResolver = authContextResolver;
+    }
+
+    @Transactional
+    public AdminAuditResponse updateUserStatus(UUID userId, UserStatusUpdateRequest request) {
+        AuthenticatedUser actor = authContextResolver.currentUser();
+        ensureAdmin(actor);
+
+        AdminAuditEntity entity = new AdminAuditEntity();
+        entity.setTenantId(actor.tenantId());
+        entity.setActorUserId(actor.userId());
+        entity.setActionType(AdminActionType.USER_STATUS_UPDATE);
+        entity.setTargetUserId(userId);
+        entity.setTargetStatus(request.status());
+        entity.setReason(request.reason());
+
+        return adminMapper.toResponse(adminAuditRepository.save(entity));
+    }
+
+    @Transactional(readOnly = true)
+    public List<AdminAuditResponse> listAudits() {
+        AuthenticatedUser actor = authContextResolver.currentUser();
+        ensureAdmin(actor);
+
+        return adminAuditRepository.findByTenantIdOrderByCreatedAtDesc(actor.tenantId())
+                .stream()
+                .map(adminMapper::toResponse)
+                .toList();
+    }
+
+    private void ensureAdmin(AuthenticatedUser actor) {
+        if (!actor.role().contains("ADMIN") && !actor.role().contains("SYSTEM")) {
+            throw new ForbiddenException("Admin or System role is required");
+        }
+    }
+}
