diff --git a/search-service/src/main/java/com/marketplace/service/SearchService.java b/search-service/src/main/java/com/marketplace/service/SearchService.java
new file mode 100644
index 0000000000000000000000000000000000000000..801d9a7885dbb8597b639eda7b30d95ff4658359
--- /dev/null
+++ b/search-service/src/main/java/com/marketplace/service/SearchService.java
@@ -0,0 +1,89 @@
+package com.marketplace.service;
+
+import com.marketplace.dto.SearchIndexRequest;
+import com.marketplace.dto.SearchResultResponse;
+import com.marketplace.entity.EntityStatus;
+import com.marketplace.entity.SearchDocumentEntity;
+import com.marketplace.exception.ForbiddenException;
+import com.marketplace.exception.NotFoundException;
+import com.marketplace.mapper.SearchMapper;
+import com.marketplace.repository.SearchDocumentRepository;
+import com.marketplace.util.AuthContextResolver;
+import com.marketplace.util.AuthenticatedUser;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.math.BigDecimal;
+import java.util.List;
+import java.util.UUID;
+
+@Service
+public class SearchService {
+    private final SearchDocumentRepository repository;
+    private final SearchMapper mapper;
+    private final AuthContextResolver authContextResolver;
+
+    public SearchService(SearchDocumentRepository repository, SearchMapper mapper, AuthContextResolver authContextResolver) {
+        this.repository = repository;
+        this.mapper = mapper;
+        this.authContextResolver = authContextResolver;
+    }
+
+    @Transactional
+    public SearchResultResponse upsert(SearchIndexRequest request) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        ensureAdminOrVendor(user);
+
+        SearchDocumentEntity entity = repository.findByProductIdAndTenantId(request.productId(), user.tenantId())
+                .orElseGet(SearchDocumentEntity::new);
+
+        if (entity.getId() != null && !entity.getVendorId().equals(user.userId()) && !user.role().contains("ADMIN")) {
+            throw new ForbiddenException("Only owner vendor can update search index");
+        }
+
+        entity.setTenantId(user.tenantId());
+        entity.setProductId(request.productId());
+        entity.setVendorId(request.vendorId());
+        entity.setProductName(request.productName());
+        entity.setCategory(request.category());
+        entity.setDescription(request.description());
+        entity.setPrice(request.price());
+        entity.setStatus(EntityStatus.ACTIVE);
+
+        return mapper.toResponse(repository.save(entity));
+    }
+
+    @Transactional(readOnly = true)
+    public List<SearchResultResponse> search(String q, String category, BigDecimal minPrice, BigDecimal maxPrice, Integer limit) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        int pageSize = limit == null || limit < 1 ? 20 : Math.min(limit, 100);
+
+        return repository.search(user.tenantId(), q, category, minPrice, maxPrice)
+                .stream()
+                .limit(pageSize)
+                .map(mapper::toResponse)
+                .toList();
+    }
+
+    @Transactional
+    public void delete(UUID productId) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        ensureAdminOrVendor(user);
+
+        SearchDocumentEntity entity = repository.findByProductIdAndTenantId(productId, user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Search index record not found"));
+
+        if (!entity.getVendorId().equals(user.userId()) && !user.role().contains("ADMIN")) {
+            throw new ForbiddenException("Only owner vendor can delete search index");
+        }
+
+        entity.setStatus(EntityStatus.DELETED);
+        repository.save(entity);
+    }
+
+    private void ensureAdminOrVendor(AuthenticatedUser user) {
+        if (!user.role().contains("VENDOR") && !user.role().contains("ADMIN")) {
+            throw new ForbiddenException("Vendor or Admin role is required");
+        }
+    }
+}
diff --git a/search-service/src/main/java/com/marketplace/util/AuthContextResolver.java b/search-service/src/main/java/com/marketplace/util/AuthContextResolver.java
new file mode 100644
