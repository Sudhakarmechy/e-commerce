+
+@WebMvcTest(PaymentController.class)
+class PaymentControllerTest {
+
+    @Autowired
+    private MockMvc mockMvc;
+    @Autowired
+    private ObjectMapper objectMapper;
+
+    @MockBean
+    private PaymentService paymentService;
+
+    @Test
+    void createPaymentShouldReturnCreated() throws Exception {
+        PaymentResponse response = new PaymentResponse(UUID.randomUUID(), UUID.randomUUID(), UUID.randomUUID(), BigDecimal.TEN,
+                BigDecimal.ZERO, PaymentMethod.CARD, null, null, null, List.of());
+        when(paymentService.createPayment(any(PaymentCreateRequest.class))).thenReturn(response);
+
+        PaymentCreateRequest request = new PaymentCreateRequest(UUID.randomUUID(), BigDecimal.TEN, PaymentMethod.CARD);
+
+        mockMvc.perform(post("/api/v1/payments")
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content(objectMapper.writeValueAsString(request)))
+                .andExpect(status().isCreated())
+                .andExpect(jsonPath("$.amount").value(10));
+    }
+}
