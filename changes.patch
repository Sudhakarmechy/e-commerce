diff --git a/delivery-service/src/main/java/com/marketplace/service/DeliveryService.java b/delivery-service/src/main/java/com/marketplace/service/DeliveryService.java
new file mode 100644
index 0000000000000000000000000000000000000000..440d8a1a78a3236c6a68f9fbaed8e27b34edecab
--- /dev/null
+++ b/delivery-service/src/main/java/com/marketplace/service/DeliveryService.java
@@ -0,0 +1,159 @@
+package com.marketplace.service;
+
+import com.marketplace.dto.*;
+import com.marketplace.entity.*;
+import com.marketplace.exception.ConflictException;
+import com.marketplace.exception.ForbiddenException;
+import com.marketplace.exception.NotFoundException;
+import com.marketplace.mapper.DeliveryMapper;
+import com.marketplace.repository.DeliveryPartnerRepository;
+import com.marketplace.repository.DeliveryRepository;
+import com.marketplace.util.AuthContextResolver;
+import com.marketplace.util.AuthenticatedUser;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.util.List;
+import java.util.UUID;
+
+@Service
+public class DeliveryService {
+
+    private final DeliveryPartnerRepository partnerRepository;
+    private final DeliveryRepository deliveryRepository;
+    private final DeliveryMapper mapper;
+    private final AuthContextResolver authContextResolver;
+
+    public DeliveryService(DeliveryPartnerRepository partnerRepository, DeliveryRepository deliveryRepository,
+                           DeliveryMapper mapper, AuthContextResolver authContextResolver) {
+        this.partnerRepository = partnerRepository;
+        this.deliveryRepository = deliveryRepository;
+        this.mapper = mapper;
+        this.authContextResolver = authContextResolver;
+    }
+
+    @Transactional
+    public DeliveryPartnerResponse upsertMyPartnerProfile(DeliveryPartnerUpsertRequest request) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        ensureDeliveryOrAdmin(user);
+
+        DeliveryPartnerEntity partner = partnerRepository.findByUserIdAndTenantId(user.userId(), user.tenantId())
+                .orElseGet(DeliveryPartnerEntity::new);
+        partner.setUserId(user.userId());
+        partner.setTenantId(user.tenantId());
+        partner.setFullName(request.fullName());
+        partner.setPhoneNumber(request.phoneNumber());
+        partner.setVehicleType(request.vehicleType());
+        partner.setAvailable(true);
+        partner.setStatus(EntityStatus.ACTIVE);
+
+        return mapper.toResponse(partnerRepository.save(partner));
+    }
+
+    @Transactional
+    public DeliveryResponse createDelivery(DeliveryCreateRequest request) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        if (!user.role().contains("ADMIN") && !user.role().contains("SYSTEM") && !user.role().contains("VENDOR")) {
+            throw new ForbiddenException("Only admin/system/vendor can create delivery");
+        }
+
+        deliveryRepository.findByOrderIdAndTenantId(request.orderId(), user.tenantId())
+                .ifPresent(existing -> { throw new ConflictException("Delivery already exists for order"); });
+
+        DeliveryEntity d = new DeliveryEntity();
+        d.setOrderId(request.orderId());
+        d.setCustomerId(request.customerId());
+        d.setVendorId(request.vendorId());
+        d.setTenantId(user.tenantId());
+        d.setPickupAddress(request.pickupAddress());
+        d.setDropAddress(request.dropAddress());
+        d.setDeliveryStatus(DeliveryStatus.CREATED);
+        d.setStatus(EntityStatus.ACTIVE);
+
+        return mapper.toResponse(deliveryRepository.save(d));
+    }
+
+    @Transactional
+    public DeliveryResponse assignDelivery(UUID deliveryId, AssignDeliveryRequest request) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        if (!user.role().contains("ADMIN") && !user.role().contains("SYSTEM")) {
+            throw new ForbiddenException("Only admin/system can assign delivery");
+        }
+
+        DeliveryEntity delivery = deliveryRepository.findByIdAndTenantId(deliveryId, user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Delivery not found"));
+
+        DeliveryPartnerEntity partner = partnerRepository.findByIdAndTenantId(request.deliveryPartnerId(), user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Delivery partner not found"));
+
+        if (!partner.isAvailable()) throw new ConflictException("Delivery partner is unavailable");
+
+        delivery.setDeliveryPartnerId(partner.getId());
+        delivery.setDeliveryStatus(DeliveryStatus.ASSIGNED);
+        partner.setAvailable(false);
+
+        partnerRepository.save(partner);
+        return mapper.toResponse(deliveryRepository.save(delivery));
+    }
+
+    @Transactional
+    public DeliveryResponse updateDeliveryStatus(UUID deliveryId, DeliveryStatusUpdateRequest request) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        DeliveryEntity delivery = deliveryRepository.findByIdAndTenantId(deliveryId, user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Delivery not found"));
+
+        boolean isAdmin = user.role().contains("ADMIN") || user.role().contains("SYSTEM");
+        boolean isAssignedPartner = delivery.getDeliveryPartnerId() != null && delivery.getDeliveryPartnerId().equals(user.userId()) && user.role().contains("DELIVERY");
+        if (!isAdmin && !isAssignedPartner) throw new ForbiddenException("Not allowed to update this delivery");
+
+        delivery.setDeliveryStatus(request.status());
+        DeliveryEntity saved = deliveryRepository.save(delivery);
+
+        if (request.status() == DeliveryStatus.DELIVERED || request.status() == DeliveryStatus.CANCELLED) {
+            if (saved.getDeliveryPartnerId() != null) {
+                partnerRepository.findByIdAndTenantId(saved.getDeliveryPartnerId(), user.tenantId()).ifPresent(p -> {
+                    p.setAvailable(true);
+                    partnerRepository.save(p);
+                });
+            }
+        }
+
+        return mapper.toResponse(saved);
+    }
+
+    @Transactional(readOnly = true)
+    public DeliveryResponse getDeliveryById(UUID deliveryId) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        DeliveryEntity d = deliveryRepository.findByIdAndTenantId(deliveryId, user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Delivery not found"));
+
+        boolean admin = user.role().contains("ADMIN") || user.role().contains("SYSTEM");
+        boolean customer = d.getCustomerId().equals(user.userId());
+        boolean vendor = d.getVendorId().equals(user.userId());
+        boolean partner = d.getDeliveryPartnerId() != null && d.getDeliveryPartnerId().equals(user.userId());
+        if (!admin && !customer && !vendor && !partner) throw new ForbiddenException("Not authorized to view this delivery");
+
+        return mapper.toResponse(d);
+    }
+
+    @Transactional(readOnly = true)
+    public List<DeliveryResponse> listMyDeliveries() {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        if (user.role().contains("DELIVERY")) {
+            return deliveryRepository.findByTenantIdAndDeliveryPartnerId(user.tenantId(), user.userId()).stream().map(mapper::toResponse).toList();
+        }
+        if (user.role().contains("CUSTOMER")) {
+            return deliveryRepository.findByTenantIdAndCustomerId(user.tenantId(), user.userId()).stream().map(mapper::toResponse).toList();
+        }
+        if (user.role().contains("ADMIN") || user.role().contains("SYSTEM")) {
+            return deliveryRepository.findAll().stream().filter(d -> d.getTenantId().equals(user.tenantId())).map(mapper::toResponse).toList();
+        }
+        throw new ForbiddenException("Role not allowed to list deliveries");
+    }
+
+    private void ensureDeliveryOrAdmin(AuthenticatedUser user) {
+        if (!user.role().contains("DELIVERY") && !user.role().contains("ADMIN")) {
+            throw new ForbiddenException("Delivery/Admin role required");
+        }
+    }
+}
diff --git a/delivery-service/src/main/java/com/marketplace/util/AuthContextResolver.java b/delivery-service/src/main/java/com/marketplace/util/AuthContextResolver.java
