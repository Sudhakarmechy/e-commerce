diff --git a/order-service/src/main/java/com/marketplace/service/OrderService.java b/order-service/src/main/java/com/marketplace/service/OrderService.java
new file mode 100644
index 0000000000000000000000000000000000000000..7b28339c1f3ef098a15e1aa005a2baedbec17ee5
--- /dev/null
+++ b/order-service/src/main/java/com/marketplace/service/OrderService.java
@@ -0,0 +1,129 @@
+package com.marketplace.service;
+
+import com.marketplace.dto.OrderCreateItemRequest;
+import com.marketplace.dto.OrderCreateRequest;
+import com.marketplace.dto.OrderResponse;
+import com.marketplace.dto.OrderStatusUpdateRequest;
+import com.marketplace.entity.EntityStatus;
+import com.marketplace.entity.OrderEntity;
+import com.marketplace.entity.OrderItemEntity;
+import com.marketplace.entity.OrderStatus;
+import com.marketplace.exception.ForbiddenException;
+import com.marketplace.exception.NotFoundException;
+import com.marketplace.mapper.OrderMapper;
+import com.marketplace.repository.OrderItemRepository;
+import com.marketplace.repository.OrderRepository;
+import com.marketplace.util.AuthContextResolver;
+import com.marketplace.util.AuthenticatedUser;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.math.BigDecimal;
+import java.util.List;
+import java.util.UUID;
+
+@Service
+public class OrderService {
+
+    private final OrderRepository orderRepository;
+    private final OrderItemRepository orderItemRepository;
+    private final OrderMapper orderMapper;
+    private final AuthContextResolver authContextResolver;
+
+    public OrderService(OrderRepository orderRepository, OrderItemRepository orderItemRepository,
+                        OrderMapper orderMapper, AuthContextResolver authContextResolver) {
+        this.orderRepository = orderRepository;
+        this.orderItemRepository = orderItemRepository;
+        this.orderMapper = orderMapper;
+        this.authContextResolver = authContextResolver;
+    }
+
+    @Transactional
+    public OrderResponse createOrder(OrderCreateRequest request) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        ensureCustomerRole(user);
+
+        UUID vendorId = request.items().getFirst().vendorId();
+        BigDecimal subtotal = request.items().stream()
+                .map(i -> i.unitPrice().multiply(BigDecimal.valueOf(i.quantity())))
+                .reduce(BigDecimal.ZERO, BigDecimal::add);
+
+        OrderEntity order = new OrderEntity();
+        order.setCustomerId(user.userId());
+        order.setTenantId(user.tenantId());
+        order.setVendorId(vendorId);
+        order.setDeliveryAddressId(request.deliveryAddressId());
+        order.setSubtotalAmount(subtotal);
+        order.setDeliveryFee(request.deliveryFee());
+        order.setTotalAmount(subtotal.add(request.deliveryFee()));
+        order.setOrderStatus(OrderStatus.CREATED);
+        order.setStatus(EntityStatus.ACTIVE);
+
+        OrderEntity saved = orderRepository.save(order);
+
+        List<OrderItemEntity> items = request.items().stream()
+                .map(item -> toOrderItem(saved.getId(), item))
+                .toList();
+        List<OrderItemEntity> savedItems = orderItemRepository.saveAll(items);
+
+        return orderMapper.toResponse(saved, savedItems);
+    }
+
+    @Transactional(readOnly = true)
+    public List<OrderResponse> listMyOrders() {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        List<OrderEntity> orders = orderRepository.findByTenantIdAndCustomerId(user.tenantId(), user.userId());
+        return orders.stream().map(o -> orderMapper.toResponse(o, orderItemRepository.findByOrderId(o.getId()))).toList();
+    }
+
+    @Transactional(readOnly = true)
+    public OrderResponse getOrderById(UUID orderId) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        OrderEntity order = orderRepository.findByIdAndTenantId(orderId, user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Order not found"));
+
+        if (!user.role().contains("ADMIN") && !order.getCustomerId().equals(user.userId()) && !order.getVendorId().equals(user.userId())) {
+            throw new ForbiddenException("Not authorized to access this order");
+        }
+
+        return orderMapper.toResponse(order, orderItemRepository.findByOrderId(orderId));
+    }
+
+    @Transactional
+    public OrderResponse updateOrderStatus(UUID orderId, OrderStatusUpdateRequest request) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        if (!user.role().contains("ADMIN") && !user.role().contains("VENDOR") && !user.role().contains("DELIVERY")) {
+            throw new ForbiddenException("Not allowed to update order status");
+        }
+
+        OrderEntity order = orderRepository.findByIdAndTenantId(orderId, user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Order not found"));
+
+        if (user.role().contains("VENDOR") && !order.getVendorId().equals(user.userId())) {
+            throw new ForbiddenException("Vendor cannot update others' orders");
+        }
+
+        order.setOrderStatus(request.status());
+        OrderEntity saved = orderRepository.save(order);
+        return orderMapper.toResponse(saved, orderItemRepository.findByOrderId(orderId));
+    }
+
+    private OrderItemEntity toOrderItem(UUID orderId, OrderCreateItemRequest req) {
+        OrderItemEntity i = new OrderItemEntity();
+        i.setOrderId(orderId);
+        i.setProductId(req.productId());
+        i.setVendorId(req.vendorId());
+        i.setProductName(req.productName());
+        i.setQuantity(req.quantity());
+        i.setUnitPrice(req.unitPrice());
+        i.setLineTotal(req.unitPrice().multiply(BigDecimal.valueOf(req.quantity())));
+        i.setStatus(EntityStatus.ACTIVE);
+        return i;
+    }
+
+    private void ensureCustomerRole(AuthenticatedUser user) {
+        if (!user.role().contains("CUSTOMER") && !user.role().contains("ADMIN")) {
+            throw new ForbiddenException("Customer role is required");
+        }
+    }
+}
