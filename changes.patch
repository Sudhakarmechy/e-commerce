diff --git a/product-service/src/main/java/com/marketplace/service/ProductService.java b/product-service/src/main/java/com/marketplace/service/ProductService.java
new file mode 100644
index 0000000000000000000000000000000000000000..9895739fd0ca698f5fb9228bbfd716044132da81
--- /dev/null
+++ b/product-service/src/main/java/com/marketplace/service/ProductService.java
@@ -0,0 +1,157 @@
+package com.marketplace.service;
+
+import com.marketplace.dto.*;
+import com.marketplace.entity.*;
+import com.marketplace.exception.ForbiddenException;
+import com.marketplace.exception.NotFoundException;
+import com.marketplace.mapper.ProductMapper;
+import com.marketplace.repository.CategoryRepository;
+import com.marketplace.repository.ProductAttributeRepository;
+import com.marketplace.repository.ProductRepository;
+import com.marketplace.util.AuthContextResolver;
+import com.marketplace.util.AuthenticatedUser;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.util.List;
+import java.util.Map;
+import java.util.UUID;
+
+@Service
+public class ProductService {
+    private final CategoryRepository categoryRepository;
+    private final ProductRepository productRepository;
+    private final ProductAttributeRepository productAttributeRepository;
+    private final ProductMapper productMapper;
+    private final AuthContextResolver authContextResolver;
+
+    public ProductService(CategoryRepository categoryRepository, ProductRepository productRepository,
+                          ProductAttributeRepository productAttributeRepository, ProductMapper productMapper,
+                          AuthContextResolver authContextResolver) {
+        this.categoryRepository = categoryRepository;
+        this.productRepository = productRepository;
+        this.productAttributeRepository = productAttributeRepository;
+        this.productMapper = productMapper;
+        this.authContextResolver = authContextResolver;
+    }
+
+    @Transactional
+    public CategoryResponse createCategory(CategoryRequest request) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        ensureAdminOrVendor(user);
+
+        CategoryEntity entity = new CategoryEntity();
+        entity.setTenantId(user.tenantId());
+        entity.setName(request.name());
+        entity.setDescription(request.description());
+        entity.setStatus(EntityStatus.ACTIVE);
+        return productMapper.toResponse(categoryRepository.save(entity));
+    }
+
+    @Transactional(readOnly = true)
+    public List<CategoryResponse> listCategories() {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        return categoryRepository.findByTenantId(user.tenantId()).stream().map(productMapper::toResponse).toList();
+    }
+
+    @Transactional
+    public ProductResponse createProduct(ProductRequest request) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        ensureAdminOrVendor(user);
+
+        CategoryEntity category = categoryRepository.findByIdAndTenantId(request.categoryId(), user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Category not found"));
+
+        ProductEntity product = new ProductEntity();
+        product.setTenantId(user.tenantId());
+        product.setVendorId(user.userId());
+        product.setCategoryId(category.getId());
+        product.setName(request.name());
+        product.setDescription(request.description());
+        product.setImageUrl(request.imageUrl());
+        product.setPrice(request.price());
+        product.setStatus(EntityStatus.ACTIVE);
+
+        ProductEntity saved = productRepository.save(product);
+        saveAttributes(saved.getId(), request.attributes());
+        return productMapper.toResponse(saved, productAttributeRepository.findByProductId(saved.getId()));
+    }
+
+    @Transactional
+    public ProductResponse updateProduct(UUID productId, ProductRequest request) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        ensureAdminOrVendor(user);
+
+        ProductEntity product = productRepository.findByIdAndTenantId(productId, user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Product not found"));
+
+        if (!product.getVendorId().equals(user.userId()) && !user.role().contains("ADMIN")) {
+            throw new ForbiddenException("Only owner vendor can update product");
+        }
+
+        product.setCategoryId(request.categoryId());
+        product.setName(request.name());
+        product.setDescription(request.description());
+        product.setImageUrl(request.imageUrl());
+        product.setPrice(request.price());
+        ProductEntity saved = productRepository.save(product);
+
+        productAttributeRepository.deleteByProductId(productId);
+        saveAttributes(productId, request.attributes());
+
+        return productMapper.toResponse(saved, productAttributeRepository.findByProductId(saved.getId()));
+    }
+
+    @Transactional(readOnly = true)
+    public List<ProductResponse> listMyProducts() {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        ensureAdminOrVendor(user);
+        return productRepository.findByTenantIdAndVendorId(user.tenantId(), user.userId())
+                .stream()
+                .map(product -> productMapper.toResponse(product, productAttributeRepository.findByProductId(product.getId())))
+                .toList();
+    }
+
+    @Transactional(readOnly = true)
+    public ProductResponse getProductById(UUID productId) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        ProductEntity product = productRepository.findByIdAndTenantId(productId, user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Product not found"));
+        return productMapper.toResponse(product, productAttributeRepository.findByProductId(productId));
+    }
+
+    @Transactional
+    public void deleteProduct(UUID productId) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        ensureAdminOrVendor(user);
+
+        ProductEntity product = productRepository.findByIdAndTenantId(productId, user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Product not found"));
+
+        if (!product.getVendorId().equals(user.userId()) && !user.role().contains("ADMIN")) {
+            throw new ForbiddenException("Only owner vendor can delete product");
+        }
+
+        product.setStatus(EntityStatus.DELETED);
+        productRepository.save(product);
+    }
+
+    private void saveAttributes(UUID productId, Map<String, String> attributes) {
+        if (attributes == null || attributes.isEmpty()) return;
+        List<ProductAttributeEntity> entities = attributes.entrySet().stream().map(entry -> {
+            ProductAttributeEntity entity = new ProductAttributeEntity();
+            entity.setProductId(productId);
+            entity.setKey(entry.getKey());
+            entity.setValue(entry.getValue());
+            entity.setStatus(EntityStatus.ACTIVE);
+            return entity;
+        }).toList();
+        productAttributeRepository.saveAll(entities);
+    }
+
+    private void ensureAdminOrVendor(AuthenticatedUser user) {
+        if (!user.role().contains("VENDOR") && !user.role().contains("ADMIN")) {
+            throw new ForbiddenException("Vendor or Admin role is required");
+        }
+    }
+}
