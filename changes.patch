+        NotificationResponse response = new NotificationResponse(UUID.randomUUID(), recipientId, NotificationChannel.EMAIL,
+                "Order confirmed", "Order #1 confirmed", "ORDER", UUID.randomUUID(), null, null, null, null);
+        when(mapper.toResponse(any(NotificationEntity.class))).thenReturn(response);
+
+        NotificationResponse created = notificationService.createNotification(new NotificationCreateRequest(
+                recipientId, NotificationChannel.EMAIL, "Order confirmed", "Order #1 confirmed", "ORDER", UUID.randomUUID()
+        ));
+
+        assertEquals(recipientId, created.recipientUserId());
+    }
+}
