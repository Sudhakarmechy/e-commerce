+package com.marketplace.util;
+
+import com.marketplace.exception.UnauthorizedException;
+import org.springframework.stereotype.Component;
+import org.springframework.web.context.request.RequestContextHolder;
+import org.springframework.web.context.request.ServletRequestAttributes;
+
+import java.util.UUID;
+
+@Component
+public class AuthContextResolver {
+    public AuthenticatedUser currentUser() {
+        ServletRequestAttributes attrs = (ServletRequestAttributes) RequestContextHolder.getRequestAttributes();
+        if (attrs == null) throw new UnauthorizedException("Request context is unavailable");
+
+        String userId = attrs.getRequest().getHeader("X-Authenticated-UserId");
+        String role = attrs.getRequest().getHeader("X-Authenticated-Role");
+        String tenantId = attrs.getRequest().getHeader("X-Authenticated-TenantId");
+        if (userId == null || role == null || tenantId == null) {
+            throw new UnauthorizedException("Missing authentication headers");
+        }
+        return new AuthenticatedUser(UUID.fromString(userId), role, tenantId);
+    }
+}
