+@ExtendWith(MockitoExtension.class)
+class OrderServiceTest {
+
+    @Mock
+    private OrderRepository orderRepository;
+    @Mock
+    private OrderItemRepository orderItemRepository;
+    @Mock
+    private OrderMapper orderMapper;
+    @Mock
+    private AuthContextResolver authContextResolver;
+
+    @InjectMocks
+    private OrderService orderService;
+
+    @Test
+    void createOrderShouldReturnCreatedOrder() {
+        UUID customerId = UUID.randomUUID();
+        UUID vendorId = UUID.randomUUID();
+        UUID productId = UUID.randomUUID();
+
+        when(authContextResolver.currentUser()).thenReturn(new AuthenticatedUser(customerId, "CUSTOMER", "tenant-1"));
+        when(orderRepository.save(any(OrderEntity.class))).thenAnswer(invocation -> invocation.getArgument(0));
+        when(orderItemRepository.saveAll(any())).thenAnswer(invocation -> invocation.getArgument(0));
+
+        OrderResponse response = new OrderResponse(UUID.randomUUID(), customerId, vendorId, UUID.randomUUID(), null,
+                BigDecimal.TEN, BigDecimal.ONE, BigDecimal.valueOf(11), List.of());
+        when(orderMapper.toResponse(any(OrderEntity.class), any())).thenReturn(response);
+
+        OrderCreateItemRequest item = new OrderCreateItemRequest(productId, vendorId, "Rose Bouquet", 1, BigDecimal.TEN);
+        OrderCreateRequest request = new OrderCreateRequest(UUID.randomUUID(), List.of(item), BigDecimal.ONE);
+
+        OrderResponse actual = orderService.createOrder(request);
+        assertEquals(BigDecimal.valueOf(11), actual.total());
