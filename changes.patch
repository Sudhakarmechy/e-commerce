+package com.marketplace.service;
+
+import com.marketplace.dto.UserProfileResponse;
+import com.marketplace.dto.UserProfileUpsertRequest;
+import com.marketplace.entity.UserProfileEntity;
+import com.marketplace.mapper.UserProfileMapper;
+import com.marketplace.repository.AddressRepository;
+import com.marketplace.repository.UserProfileRepository;
+import com.marketplace.util.AuthContextResolver;
+import com.marketplace.util.AuthenticatedUser;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.InjectMocks;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+
+import java.util.Optional;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.when;
+
+@ExtendWith(MockitoExtension.class)
+class UserProfileServiceTest {
+
+    @Mock
+    private UserProfileRepository userProfileRepository;
+    @Mock
+    private AddressRepository addressRepository;
+    @Mock
+    private UserProfileMapper userProfileMapper;
+    @Mock
+    private AuthContextResolver authContextResolver;
+
+    @InjectMocks
+    private UserProfileService userProfileService;
+
+    @Test
+    void upsertMyProfileShouldCreateProfile() {
+        UUID userId = UUID.randomUUID();
+        when(authContextResolver.currentUser()).thenReturn(new AuthenticatedUser(userId, "CUSTOMER", "tenant-1"));
+        when(userProfileRepository.findByUserIdAndTenantId(userId, "tenant-1")).thenReturn(Optional.empty());
+        when(userProfileRepository.save(any(UserProfileEntity.class))).thenAnswer(invocation -> invocation.getArgument(0));
+
+        UserProfileResponse expected = new UserProfileResponse(userId, "tenant-1", "Jane Doe", "+911234567890", "jane@example.com", "{}" );
+        when(userProfileMapper.toResponse(any(UserProfileEntity.class))).thenReturn(expected);
+
+        UserProfileResponse actual = userProfileService.upsertMyProfile(
+                new UserProfileUpsertRequest("Jane Doe", "+911234567890", "jane@example.com", "{}")
+        );
+
+        assertEquals("Jane Doe", actual.fullName());
+        assertEquals("tenant-1", actual.tenantId());
+    }
+}
diff --git a/vendor-service/README.md b/vendor-service/README.md
new file mode 100644
