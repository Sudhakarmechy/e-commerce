+package com.marketplace.service;
+
+import com.marketplace.dto.AddCartItemRequest;
+import com.marketplace.dto.CartResponse;
+import com.marketplace.dto.UpdateCartItemRequest;
+import com.marketplace.entity.Cart;
+import com.marketplace.entity.CartItem;
+import com.marketplace.exception.NotFoundException;
+import com.marketplace.mapper.CartMapper;
+import com.marketplace.repository.CartRepository;
+import com.marketplace.util.AuthContextResolver;
+import com.marketplace.util.AuthenticatedUser;
+import org.springframework.stereotype.Service;
+
+import java.util.ArrayList;
+import java.util.UUID;
+
+@Service
+public class CartService {
+
+    private final CartRepository cartRepository;
+    private final AuthContextResolver authContextResolver;
+    private final CartMapper cartMapper;
+
+    public CartService(CartRepository cartRepository, AuthContextResolver authContextResolver, CartMapper cartMapper) {
+        this.cartRepository = cartRepository;
+        this.authContextResolver = authContextResolver;
+        this.cartMapper = cartMapper;
+    }
+
+    public CartResponse getMyCart() {
+        String key = cartKey(currentUser());
+        Cart cart = cartRepository.findByKey(key).orElseGet(() -> {
+            Cart c = new Cart();
+            c.setCartId(key);
+            c.setItems(new ArrayList<>());
+            return c;
+        });
+        return cartMapper.toResponse(cart);
+    }
+
+    public CartResponse addItem(AddCartItemRequest request) {
+        String key = cartKey(currentUser());
+        Cart cart = cartRepository.findByKey(key).orElseGet(() -> {
+            Cart c = new Cart();
+            c.setCartId(key);
+            return c;
+        });
+
+        CartItem item = cart.getItems().stream()
+                .filter(i -> i.getProductId().equals(request.productId()))
+                .findFirst()
+                .orElse(null);
+
+        if (item == null) {
+            item = new CartItem();
+            item.setProductId(request.productId());
+            item.setVendorId(request.vendorId());
+            item.setProductName(request.productName());
+            item.setImageUrl(request.imageUrl());
+            item.setUnitPrice(request.unitPrice());
+            item.setQuantity(request.quantity());
+            cart.getItems().add(item);
+        } else {
+            item.setQuantity(item.getQuantity() + request.quantity());
+            item.setUnitPrice(request.unitPrice());
+        }
+
+        cartRepository.save(key, cart);
+        return cartMapper.toResponse(cart);
+    }
+
+    public CartResponse updateItem(UUID productId, UpdateCartItemRequest request) {
+        String key = cartKey(currentUser());
+        Cart cart = cartRepository.findByKey(key).orElseThrow(() -> new NotFoundException("Cart not found"));
+
+        CartItem item = cart.getItems().stream()
+                .filter(i -> i.getProductId().equals(productId))
+                .findFirst()
+                .orElseThrow(() -> new NotFoundException("Cart item not found"));
+        item.setQuantity(request.quantity());
+
+        cartRepository.save(key, cart);
+        return cartMapper.toResponse(cart);
+    }
+
+    public CartResponse removeItem(UUID productId) {
+        String key = cartKey(currentUser());
+        Cart cart = cartRepository.findByKey(key).orElseThrow(() -> new NotFoundException("Cart not found"));
+        cart.getItems().removeIf(i -> i.getProductId().equals(productId));
+        cartRepository.save(key, cart);
+        return cartMapper.toResponse(cart);
+    }
+
+    public void clearCart() {
+        cartRepository.delete(cartKey(currentUser()));
+    }
+
+    private AuthenticatedUser currentUser() { return authContextResolver.currentUser(); }
+
+    private String cartKey(AuthenticatedUser user) {
+        return "cart:" + user.tenantId() + ":" + user.userId();
+    }
+}
