@@ -0,0 +1,92 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+
+PG_HOST="${PG_HOST:-localhost}"
+PG_PORT="${PG_PORT:-5432}"
+PG_SUPERUSER="${PG_SUPERUSER:-postgres}"
+PG_SUPERPASS="${PG_SUPERPASS:-postgres}"
+APP_DB_USER="${APP_DB_USER:-marketplace}"
+APP_DB_PASS="${APP_DB_PASS:-marketplace}"
+
+DBS=(
+  marketplace_auth
+  marketplace_user
+  marketplace_vendor
+  marketplace_product
+  marketplace_inventory
+  marketplace_order
+  marketplace_payment
+  marketplace_delivery
+  marketplace_notification
+  marketplace_search
+  marketplace_admin
+)
+
+declare -A MIGRATIONS=(
+  [marketplace_auth]="auth-service/src/main/resources/db/migration/V1__init_auth_schema.sql"
+  [marketplace_user]="user-service/src/main/resources/db/migration/V1__init_user_schema.sql"
+  [marketplace_vendor]="vendor-service/src/main/resources/db/migration/V1__init_vendor_schema.sql"
+  [marketplace_product]="product-service/src/main/resources/db/migration/V1__init_product_schema.sql"
+  [marketplace_inventory]="inventory-service/src/main/resources/db/migration/V1__init_inventory_schema.sql"
+  [marketplace_order]="order-service/src/main/resources/db/migration/V1__init_order_schema.sql"
+  [marketplace_payment]="payment-service/src/main/resources/db/migration/V1__init_payment_schema.sql"
+  [marketplace_delivery]="delivery-service/src/main/resources/db/migration/V1__init_delivery_schema.sql"
+  [marketplace_notification]="notification-service/src/main/resources/db/migration/V1__init_notification_schema.sql"
+  [marketplace_search]="search-service/src/main/resources/db/migration/V1__init_search_schema.sql"
+  [marketplace_admin]="admin-service/src/main/resources/db/migration/V1__init_admin_schema.sql"
+)
+
+need_cmd() {
+  command -v "$1" >/dev/null 2>&1 || { echo "Missing required command: $1" >&2; exit 1; }
+}
+
+need_cmd psql
+need_cmd pg_isready
+
+echo "[1/4] Waiting for PostgreSQL on ${PG_HOST}:${PG_PORT}..."
+export PGPASSWORD="$PG_SUPERPASS"
+until pg_isready -h "$PG_HOST" -p "$PG_PORT" -U "$PG_SUPERUSER" -d postgres >/dev/null 2>&1; do
+  sleep 1
+done
+
+echo "[2/4] Ensuring app role exists: ${APP_DB_USER}"
+psql -h "$PG_HOST" -p "$PG_PORT" -U "$PG_SUPERUSER" -d postgres -v ON_ERROR_STOP=1 <<SQL
+DO
+\$\$
+BEGIN
+   IF NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = '${APP_DB_USER}') THEN
+      CREATE ROLE ${APP_DB_USER} LOGIN PASSWORD '${APP_DB_PASS}';
+   END IF;
+END
+\$\$;
+SQL
+
+echo "[3/4] Creating databases + grants"
+for db in "${DBS[@]}"; do
+  psql -h "$PG_HOST" -p "$PG_PORT" -U "$PG_SUPERUSER" -d postgres -v ON_ERROR_STOP=1 <<SQL
+SELECT 'CREATE DATABASE ${db}' WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '${db}')\gexec
+GRANT ALL PRIVILEGES ON DATABASE ${db} TO ${APP_DB_USER};
+SQL
+
+  psql -h "$PG_HOST" -p "$PG_PORT" -U "$PG_SUPERUSER" -d "$db" -v ON_ERROR_STOP=1 <<SQL
+GRANT ALL ON SCHEMA public TO ${APP_DB_USER};
+ALTER SCHEMA public OWNER TO ${APP_DB_USER};
+SQL
+done
+
+echo "[4/4] Applying base SQL migrations (V1)"
+for db in "${DBS[@]}"; do
+  migration_path="${MIGRATIONS[$db]}"
+  full_path="${ROOT_DIR}/${migration_path}"
+  if [[ ! -f "$full_path" ]]; then
+    echo "ERROR: migration file not found for ${db}: ${full_path}" >&2
+    exit 1
+  fi
+
+  echo "  -> ${db} <= ${migration_path}"
+  psql -h "$PG_HOST" -p "$PG_PORT" -U "$PG_SUPERUSER" -d "$db" -v ON_ERROR_STOP=1 -f "$full_path"
+done
+
+echo "Done. Databases and baseline tables are ready."
