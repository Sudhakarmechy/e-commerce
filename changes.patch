diff --git a/inventory-service/src/main/java/com/marketplace/service/InventoryService.java b/inventory-service/src/main/java/com/marketplace/service/InventoryService.java
new file mode 100644
index 0000000000000000000000000000000000000000..a1d9b7b95cf1a2f0117d3af150f6bf541dd93473
--- /dev/null
+++ b/inventory-service/src/main/java/com/marketplace/service/InventoryService.java
@@ -0,0 +1,166 @@
+package com.marketplace.service;
+
+import com.marketplace.dto.*;
+import com.marketplace.entity.*;
+import com.marketplace.exception.ConflictException;
+import com.marketplace.exception.ForbiddenException;
+import com.marketplace.exception.NotFoundException;
+import com.marketplace.mapper.InventoryMapper;
+import com.marketplace.repository.InventoryMovementRepository;
+import com.marketplace.repository.InventoryRepository;
+import com.marketplace.util.AuthContextResolver;
+import com.marketplace.util.AuthenticatedUser;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.util.List;
+import java.util.UUID;
+
+@Service
+public class InventoryService {
+
+    private final InventoryRepository inventoryRepository;
+    private final InventoryMovementRepository movementRepository;
+    private final InventoryMapper inventoryMapper;
+    private final AuthContextResolver authContextResolver;
+
+    public InventoryService(InventoryRepository inventoryRepository,
+                            InventoryMovementRepository movementRepository,
+                            InventoryMapper inventoryMapper,
+                            AuthContextResolver authContextResolver) {
+        this.inventoryRepository = inventoryRepository;
+        this.movementRepository = movementRepository;
+        this.inventoryMapper = inventoryMapper;
+        this.authContextResolver = authContextResolver;
+    }
+
+    @Transactional
+    public InventoryResponse stockIn(StockAdjustRequest request) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        ensureVendorOrAdmin(user);
+
+        InventoryEntity inventory = getOrCreateInventory(user, request.productId());
+        inventory.setAvailableQuantity(inventory.getAvailableQuantity() + request.quantity());
+        InventoryEntity saved = inventoryRepository.save(inventory);
+
+        recordMovement(saved, null, InventoryOperationType.STOCK_IN, request.quantity(), request.notes());
+        return inventoryMapper.toResponse(saved);
+    }
+
+    @Transactional
+    public InventoryResponse reserveStock(StockReserveRequest request) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        ensureVendorOrAdmin(user);
+
+        InventoryEntity inventory = inventoryRepository.findByTenantIdAndVendorIdAndProductId(user.tenantId(), user.userId(), request.productId())
+                .orElseThrow(() -> new NotFoundException("Inventory not found for product"));
+
+        if (inventory.getAvailableQuantity() < request.quantity()) {
+            throw new ConflictException("Insufficient stock for reservation");
+        }
+
+        inventory.setAvailableQuantity(inventory.getAvailableQuantity() - request.quantity());
+        inventory.setReservedQuantity(inventory.getReservedQuantity() + request.quantity());
+
+        InventoryEntity saved = inventoryRepository.save(inventory);
+        recordMovement(saved, request.orderId(), InventoryOperationType.ORDER_RESERVATION, request.quantity(), "Stock reserved");
+        return inventoryMapper.toResponse(saved);
+    }
+
+    @Transactional
+    public InventoryResponse releaseReservedStock(StockReleaseRequest request) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        ensureVendorOrAdmin(user);
+
+        InventoryEntity inventory = inventoryRepository.findByTenantIdAndVendorIdAndProductId(user.tenantId(), user.userId(), request.productId())
+                .orElseThrow(() -> new NotFoundException("Inventory not found for product"));
+
+        if (inventory.getReservedQuantity() < request.quantity()) {
+            throw new ConflictException("Insufficient reserved stock to release");
+        }
+
+        inventory.setReservedQuantity(inventory.getReservedQuantity() - request.quantity());
+        inventory.setAvailableQuantity(inventory.getAvailableQuantity() + request.quantity());
+
+        InventoryEntity saved = inventoryRepository.save(inventory);
+        recordMovement(saved, request.orderId(), InventoryOperationType.ORDER_RELEASE, request.quantity(), "Reserved stock released");
+        return inventoryMapper.toResponse(saved);
+    }
+
+    @Transactional
+    public InventoryResponse recordOfflineSale(StockAdjustRequest request) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        ensureVendorOrAdmin(user);
+
+        InventoryEntity inventory = inventoryRepository.findByTenantIdAndVendorIdAndProductId(user.tenantId(), user.userId(), request.productId())
+                .orElseThrow(() -> new NotFoundException("Inventory not found for product"));
+
+        if (inventory.getAvailableQuantity() < request.quantity()) {
+            throw new ConflictException("Insufficient stock for offline sale");
+        }
+
+        inventory.setAvailableQuantity(inventory.getAvailableQuantity() - request.quantity());
+        InventoryEntity saved = inventoryRepository.save(inventory);
+
+        recordMovement(saved, null, InventoryOperationType.OFFLINE_SALE, request.quantity(), request.notes());
+        return inventoryMapper.toResponse(saved);
+    }
+
+    @Transactional(readOnly = true)
+    public List<InventoryResponse> listMyInventory() {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        ensureVendorOrAdmin(user);
+
+        return inventoryRepository.findByTenantIdAndVendorId(user.tenantId(), user.userId())
+                .stream()
+                .map(inventoryMapper::toResponse)
+                .toList();
+    }
+
+    @Transactional(readOnly = true)
+    public List<InventoryMovementResponse> listMovements(UUID inventoryId) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        ensureVendorOrAdmin(user);
+
+        InventoryEntity inventory = inventoryRepository.findByIdAndTenantId(inventoryId, user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Inventory not found"));
+        if (!inventory.getVendorId().equals(user.userId()) && !user.role().contains("ADMIN")) {
+            throw new ForbiddenException("Only owner vendor can view movements");
+        }
+
+        return movementRepository.findByInventoryIdOrderByCreatedAtDesc(inventoryId)
+                .stream().map(inventoryMapper::toResponse).toList();
+    }
+
+    private InventoryEntity getOrCreateInventory(AuthenticatedUser user, UUID productId) {
+        return inventoryRepository.findByTenantIdAndVendorIdAndProductId(user.tenantId(), user.userId(), productId)
+                .orElseGet(() -> {
+                    InventoryEntity entity = new InventoryEntity();
+                    entity.setTenantId(user.tenantId());
+                    entity.setVendorId(user.userId());
+                    entity.setProductId(productId);
+                    entity.setAvailableQuantity(0);
+                    entity.setReservedQuantity(0);
+                    entity.setStatus(EntityStatus.ACTIVE);
+                    return entity;
+                });
+    }
+
+    private void recordMovement(InventoryEntity inventory, UUID orderId, InventoryOperationType type, Integer quantity, String notes) {
+        InventoryMovementEntity movement = new InventoryMovementEntity();
+        movement.setInventoryId(inventory.getId());
+        movement.setTenantId(inventory.getTenantId());
+        movement.setOrderId(orderId);
+        movement.setOperationType(type);
+        movement.setQuantity(quantity);
+        movement.setNotes(notes);
+        movement.setStatus(EntityStatus.ACTIVE);
+        movementRepository.save(movement);
+    }
+
+    private void ensureVendorOrAdmin(AuthenticatedUser user) {
+        if (!user.role().contains("VENDOR") && !user.role().contains("ADMIN")) {
+            throw new ForbiddenException("Vendor or Admin role is required");
+        }
+    }
+}
diff --git a/inventory-service/src/main/java/com/marketplace/util/AuthContextResolver.java b/inventory-service/src/main/java/com/marketplace/util/AuthContextResolver.java
