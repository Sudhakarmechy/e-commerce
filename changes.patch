+package com.marketplace.repository;
+
+import com.marketplace.entity.Cart;
+import org.springframework.data.redis.core.RedisTemplate;
+import org.springframework.stereotype.Repository;
+
+import java.time.Duration;
+import java.util.Optional;
+
+@Repository
+public class CartRepository {
+
+    private final RedisTemplate<String, Cart> redisTemplate;
+    private static final Duration TTL = Duration.ofDays(7);
+
+    public CartRepository(RedisTemplate<String, Cart> redisTemplate) {
+        this.redisTemplate = redisTemplate;
+    }
+
+    public Optional<Cart> findByKey(String key) {
+        return Optional.ofNullable(redisTemplate.opsForValue().get(key));
+    }
+
+    public void save(String key, Cart cart) {
+        redisTemplate.opsForValue().set(key, cart, TTL);
+    }
+
+    public void delete(String key) {
+        redisTemplate.delete(key);
+    }
+}
