+CREATE TABLE delivery_partners (
+    id UUID PRIMARY KEY,
+    user_id UUID NOT NULL UNIQUE,
+    tenant_id VARCHAR(100) NOT NULL,
+    full_name VARCHAR(255) NOT NULL,
+    phone_number VARCHAR(20) NOT NULL,
+    vehicle_type VARCHAR(100),
+    is_available BOOLEAN NOT NULL,
+    status VARCHAR(20) NOT NULL,
+    created_at TIMESTAMPTZ NOT NULL,
+    updated_at TIMESTAMPTZ NOT NULL
+);
+
+CREATE TABLE deliveries (
+    id UUID PRIMARY KEY,
+    order_id UUID NOT NULL UNIQUE,
+    customer_id UUID NOT NULL,
+    vendor_id UUID NOT NULL,
+    tenant_id VARCHAR(100) NOT NULL,
+    delivery_partner_id UUID,
+    pickup_address TEXT NOT NULL,
+    drop_address TEXT NOT NULL,
+    delivery_status VARCHAR(30) NOT NULL,
+    status VARCHAR(20) NOT NULL,
+    created_at TIMESTAMPTZ NOT NULL,
+    updated_at TIMESTAMPTZ NOT NULL,
+    CONSTRAINT fk_deliveries_partner FOREIGN KEY(delivery_partner_id) REFERENCES delivery_partners(id)
+);
+
+CREATE INDEX idx_delivery_partners_tenant_available ON delivery_partners(tenant_id, is_available);
+CREATE INDEX idx_deliveries_tenant_customer ON deliveries(tenant_id, customer_id);
+CREATE INDEX idx_deliveries_tenant_partner ON deliveries(tenant_id, delivery_partner_id);
+CREATE INDEX idx_deliveries_tenant_status ON deliveries(tenant_id, delivery_status);
