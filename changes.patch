+
+@WebMvcTest(OrderController.class)
+class OrderControllerTest {
+
+    @Autowired
+    private MockMvc mockMvc;
+    @Autowired
+    private ObjectMapper objectMapper;
+
+    @MockBean
+    private OrderService orderService;
+
+    @Test
+    void createOrderShouldReturnCreated() throws Exception {
+        OrderResponse response = new OrderResponse(UUID.randomUUID(), UUID.randomUUID(), UUID.randomUUID(), UUID.randomUUID(), null,
+                BigDecimal.TEN, BigDecimal.ONE, BigDecimal.valueOf(11), List.of());
+        when(orderService.createOrder(any(OrderCreateRequest.class))).thenReturn(response);
+
+        OrderCreateItemRequest item = new OrderCreateItemRequest(UUID.randomUUID(), UUID.randomUUID(), "Rose", 1, BigDecimal.TEN);
+        OrderCreateRequest request = new OrderCreateRequest(UUID.randomUUID(), List.of(item), BigDecimal.ONE);
+
+        mockMvc.perform(post("/api/v1/orders")
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content(objectMapper.writeValueAsString(request)))
+                .andExpect(status().isCreated())
+                .andExpect(jsonPath("$.total").value(11));
+    }
+}
