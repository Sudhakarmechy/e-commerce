+#!/usr/bin/env bash
+set -euo pipefail
+
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+LOG_DIR="${ROOT_DIR}/.run-logs"
+mkdir -p "$LOG_DIR"
+
+# Avoid default port clash (inventory-service and search-service both configured for 8088)
+INVENTORY_PORT="${INVENTORY_PORT:-8094}"
+
+start_service() {
+  local name="$1"
+  local dir="$2"
+  local extra_args="${3:-}"
+
+  echo "Starting ${name}..."
+  (cd "${ROOT_DIR}/${dir}" && nohup mvn spring-boot:run ${extra_args} > "${LOG_DIR}/${name}.log" 2>&1 &)
+}
+
+start_service "auth-service" "auth-service"
+start_service "user-service" "user-service"
+start_service "vendor-service" "vendor-service"
+start_service "product-service" "product-service"
+start_service "inventory-service" "inventory-service" "-Dspring-boot.run.arguments=--server.port=${INVENTORY_PORT}"
+start_service "cart-service" "cart-service"
+start_service "order-service" "order-service"
+start_service "payment-service" "payment-service"
+start_service "delivery-service" "delivery-service"
+start_service "notification-service" "notification-service"
+start_service "search-service" "search-service"
+start_service "admin-service" "admin-service"
+
+# Gateway last
+start_service "api-gateway" "api-gateway"
+
+echo "All start commands triggered. Logs: ${LOG_DIR}"
+echo "Tip: tail -f ${LOG_DIR}/api-gateway.log"
