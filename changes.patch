+package com.marketplace.service;
+
+import com.marketplace.dto.AddressRequest;
+import com.marketplace.dto.AddressResponse;
+import com.marketplace.dto.UserProfileResponse;
+import com.marketplace.dto.UserProfileUpsertRequest;
+import com.marketplace.entity.AddressEntity;
+import com.marketplace.entity.EntityStatus;
+import com.marketplace.entity.UserProfileEntity;
+import com.marketplace.exception.NotFoundException;
+import com.marketplace.mapper.UserProfileMapper;
+import com.marketplace.repository.AddressRepository;
+import com.marketplace.repository.UserProfileRepository;
+import com.marketplace.util.AuthContextResolver;
+import com.marketplace.util.AuthenticatedUser;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.util.List;
+import java.util.UUID;
+
+@Service
+public class UserProfileService {
+
+    private final UserProfileRepository userProfileRepository;
+    private final AddressRepository addressRepository;
+    private final UserProfileMapper userProfileMapper;
+    private final AuthContextResolver authContextResolver;
+
+    public UserProfileService(UserProfileRepository userProfileRepository,
+                              AddressRepository addressRepository,
+                              UserProfileMapper userProfileMapper,
+                              AuthContextResolver authContextResolver) {
+        this.userProfileRepository = userProfileRepository;
+        this.addressRepository = addressRepository;
+        this.userProfileMapper = userProfileMapper;
+        this.authContextResolver = authContextResolver;
+    }
+
+    @Transactional(readOnly = true)
+    public UserProfileResponse getMyProfile() {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        UserProfileEntity profile = userProfileRepository.findByUserIdAndTenantId(user.userId(), user.tenantId())
+                .orElseThrow(() -> new NotFoundException("User profile not found"));
+        return userProfileMapper.toResponse(profile);
+    }
+
+    @Transactional
+    public UserProfileResponse upsertMyProfile(UserProfileUpsertRequest request) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        UserProfileEntity profile = userProfileRepository.findByUserIdAndTenantId(user.userId(), user.tenantId())
+                .orElseGet(UserProfileEntity::new);
+
+        profile.setUserId(user.userId());
+        profile.setTenantId(user.tenantId());
+        profile.setFullName(request.fullName());
+        profile.setPhoneNumber(request.phoneNumber());
+        profile.setEmail(request.email().toLowerCase());
+        profile.setPreferences(request.preferences());
+        profile.setStatus(EntityStatus.ACTIVE);
+
+        return userProfileMapper.toResponse(userProfileRepository.save(profile));
+    }
+
+    @Transactional(readOnly = true)
+    public List<AddressResponse> listMyAddresses() {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        return addressRepository.findByUserIdAndTenantId(user.userId(), user.tenantId())
+                .stream()
+                .map(userProfileMapper::toResponse)
+                .toList();
+    }
+
+    @Transactional
+    public AddressResponse addMyAddress(AddressRequest request) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        AddressEntity entity = new AddressEntity();
+        mapAddress(entity, request, user.userId(), user.tenantId());
+
+        if (request.isDefault()) {
+            unsetExistingDefault(user.userId(), user.tenantId());
+        }
+
+        return userProfileMapper.toResponse(addressRepository.save(entity));
+    }
+
+    @Transactional
+    public AddressResponse updateMyAddress(UUID addressId, AddressRequest request) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        AddressEntity entity = addressRepository.findByIdAndUserIdAndTenantId(addressId, user.userId(), user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Address not found"));
+
+        mapAddress(entity, request, user.userId(), user.tenantId());
+
+        if (request.isDefault()) {
+            unsetExistingDefault(user.userId(), user.tenantId());
+            entity.setDefault(true);
+        }
+
+        return userProfileMapper.toResponse(addressRepository.save(entity));
+    }
+
+    @Transactional
+    public void deleteMyAddress(UUID addressId) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        AddressEntity entity = addressRepository.findByIdAndUserIdAndTenantId(addressId, user.userId(), user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Address not found"));
+        entity.setStatus(EntityStatus.DELETED);
+        addressRepository.save(entity);
+    }
+
+    private void mapAddress(AddressEntity entity, AddressRequest request, UUID userId, String tenantId) {
+        entity.setUserId(userId);
+        entity.setTenantId(tenantId);
+        entity.setLabel(request.label());
+        entity.setLine1(request.line1());
+        entity.setLine2(request.line2());
+        entity.setCity(request.city());
+        entity.setState(request.state());
+        entity.setPostalCode(request.postalCode());
+        entity.setLatitude(request.latitude());
+        entity.setLongitude(request.longitude());
+        entity.setDefault(request.isDefault());
+        entity.setStatus(EntityStatus.ACTIVE);
+    }
+
+    private void unsetExistingDefault(UUID userId, String tenantId) {
+        List<AddressEntity> addresses = addressRepository.findByUserIdAndTenantId(userId, tenantId);
+        addresses.forEach(address -> address.setDefault(false));
+        addressRepository.saveAll(addresses);
+    }
+}
