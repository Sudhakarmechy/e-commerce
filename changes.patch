@@ -0,0 +1,30 @@
+CREATE TABLE inventory (
+    id UUID PRIMARY KEY,
+    vendor_id UUID NOT NULL,
+    product_id UUID NOT NULL,
+    tenant_id VARCHAR(100) NOT NULL,
+    available_quantity INTEGER NOT NULL,
+    reserved_quantity INTEGER NOT NULL,
+    status VARCHAR(20) NOT NULL,
+    created_at TIMESTAMPTZ NOT NULL,
+    updated_at TIMESTAMPTZ NOT NULL,
+    CONSTRAINT uq_inventory_vendor_product_tenant UNIQUE(vendor_id, product_id, tenant_id)
+);
+
+CREATE TABLE inventory_movements (
+    id UUID PRIMARY KEY,
+    inventory_id UUID NOT NULL,
+    tenant_id VARCHAR(100) NOT NULL,
+    order_id UUID,
+    operation_type VARCHAR(50) NOT NULL,
+    quantity INTEGER NOT NULL,
+    notes TEXT,
+    status VARCHAR(20) NOT NULL,
+    created_at TIMESTAMPTZ NOT NULL,
+    updated_at TIMESTAMPTZ NOT NULL,
+    CONSTRAINT fk_inventory_movements_inventory FOREIGN KEY(inventory_id) REFERENCES inventory(id)
+);
+
+CREATE INDEX idx_inventory_tenant_vendor ON inventory(tenant_id, vendor_id);
+CREATE INDEX idx_inventory_tenant_product ON inventory(tenant_id, product_id);
+CREATE INDEX idx_inventory_movements_inventory ON inventory_movements(inventory_id);
