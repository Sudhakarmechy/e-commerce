+        when(cartRepository.findByKey("cart:tenant-1:" + userId)).thenReturn(Optional.of(new Cart()));
+
+        CartResponse response = new CartResponse("cart:tenant-1:" + userId, java.util.List.of(), 1, BigDecimal.TEN);
+        when(cartMapper.toResponse(any(Cart.class))).thenReturn(response);
+
+        CartResponse actual = cartService.addItem(new AddCartItemRequest(productId, UUID.randomUUID(), 1, BigDecimal.TEN, "Rose", null));
+        assertEquals(BigDecimal.TEN, actual.subtotal());
+    }
+}
