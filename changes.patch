+        SignupRequest request = new SignupRequest("test@marketplace.com", "password123", Set.of(Role.CUSTOMER), "tenant-1");
+
+        mockMvc.perform(post("/api/v1/auth/signup")
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content(objectMapper.writeValueAsString(request)))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.accessToken").value("token"));
+    }
+
+    @Test
+    void loginShouldReturnUnauthorizedForInvalidPayload() throws Exception {
+        LoginRequest request = new LoginRequest("not-an-email", "pass");
+
+        mockMvc.perform(post("/api/v1/auth/login")
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content(objectMapper.writeValueAsString(request)))
+                .andExpect(status().isBadRequest());
+    }
+}
