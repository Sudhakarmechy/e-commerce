index 0000000000000000000000000000000000000000..4a5b0d2fb2656244d4a1713f9bb99c25abccadcb
--- /dev/null
+++ b/api-gateway/src/test/java/com/marketplace/filter/AuthenticationGatewayFilterTest.java
@@ -0,0 +1,74 @@
+package com.marketplace.filter;
+
+import com.marketplace.dto.TokenValidationResponse;
+import com.marketplace.service.AuthValidationClient;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+import org.springframework.cloud.gateway.filter.GatewayFilterChain;
+import org.springframework.http.HttpHeaders;
+import org.springframework.mock.http.server.reactive.MockServerHttpRequest;
+import org.springframework.mock.web.server.MockServerWebExchange;
+import reactor.core.publisher.Mono;
+import reactor.test.StepVerifier;
+
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.when;
+
+@ExtendWith(MockitoExtension.class)
+class AuthenticationGatewayFilterTest {
+
+    @Mock
+    private AuthValidationClient authValidationClient;
+
+    @Mock
+    private GatewayFilterChain gatewayFilterChain;
+
+    private AuthenticationGatewayFilter filter;
+
+    @BeforeEach
+    void setUp() {
+        filter = new AuthenticationGatewayFilter(authValidationClient);
+        when(gatewayFilterChain.filter(any())).thenReturn(Mono.empty());
+    }
+
+    @Test
+    void shouldBypassPublicPath() {
+        MockServerWebExchange exchange = MockServerWebExchange.from(
+                MockServerHttpRequest.get("/api/v1/auth/login").build()
+        );
+
+        StepVerifier.create(filter.filter(exchange, gatewayFilterChain))
+                .verifyComplete();
+    }
+
+    @Test
+    void shouldReturnUnauthorizedWhenMissingAuthorization() {
+        MockServerWebExchange exchange = MockServerWebExchange.from(
+                MockServerHttpRequest.get("/api/v1/orders/123").build()
+        );
+
+        StepVerifier.create(filter.filter(exchange, gatewayFilterChain))
+                .verifyComplete();
+
+        assert exchange.getResponse().getStatusCode() != null;
+        assert exchange.getResponse().getStatusCode().value() == 401;
+    }
+
+    @Test
+    void shouldInjectIdentityHeadersForValidToken() {
+        MockServerWebExchange exchange = MockServerWebExchange.from(
+                MockServerHttpRequest.get("/api/v1/orders/123")
+                        .header(HttpHeaders.AUTHORIZATION, "Bearer valid-token")
+                        .build()
+        );
+
+        when(authValidationClient.validate("Bearer valid-token"))
+                .thenReturn(Mono.just(new TokenValidationResponse(true, "u-1", "CUSTOMER", "t-1")));
+
+        StepVerifier.create(filter.filter(exchange, gatewayFilterChain))
+                .verifyComplete();
+    }
+}
diff --git a/auth-service/README.md b/auth-service/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..be77c8156a814fa2ffc3d76462cf835acf1dee41
--- /dev/null
+++ b/auth-service/README.md
@@ -0,0 +1,45 @@
+# Auth Service (Step 1)
+
+Production-ready Spring Boot microservice for authentication and JWT issuance for the hyperlocal marketplace platform.
+
+## Responsibilities
+- User signup and login
+- Password hashing with BCrypt
+- JWT generation (`userId`, `role`, `tenantId` claims)
+- Token validation endpoint for API Gateway integration
+- Role-aware authentication foundation (`CUSTOMER`, `VENDOR`, `DELIVERY`, `ADMIN`)
+
+## API Contracts
+Base path: `/api/v1/auth`
+
+1. `POST /signup`
+   - Registers new user
+   - Request: `email`, `password`, `roles`, `tenantId`
+   - Response: access token and identity claims
+
+2. `POST /login`
+   - Authenticates user credentials
+   - Request: `email`, `password`
+   - Response: access token and identity claims
+
+3. `GET /validate`
+   - Validates bearer token and returns principal claims
+   - Header: `Authorization: Bearer <jwt>`
+
+## Data Model
+- `users`
+- `user_roles`
+
+Managed via Flyway migration: `V1__init_auth_schema.sql`.
+
+## Local Run
+```bash
+cd auth-service
+mvn spring-boot:run
+```
+
+## Test
+```bash
+cd auth-service
+mvn test
+```
