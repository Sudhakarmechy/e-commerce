diff --git a/payment-service/src/main/java/com/marketplace/service/PaymentService.java b/payment-service/src/main/java/com/marketplace/service/PaymentService.java
new file mode 100644
index 0000000000000000000000000000000000000000..16fd3676b60519338507c0bc9e62c48e7c9c5233
--- /dev/null
+++ b/payment-service/src/main/java/com/marketplace/service/PaymentService.java
@@ -0,0 +1,165 @@
+package com.marketplace.service;
+
+import com.marketplace.dto.*;
+import com.marketplace.entity.*;
+import com.marketplace.exception.ConflictException;
+import com.marketplace.exception.ForbiddenException;
+import com.marketplace.exception.NotFoundException;
+import com.marketplace.mapper.PaymentMapper;
+import com.marketplace.repository.PaymentRefundRepository;
+import com.marketplace.repository.PaymentRepository;
+import com.marketplace.util.AuthContextResolver;
+import com.marketplace.util.AuthenticatedUser;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.math.BigDecimal;
+import java.util.List;
+import java.util.UUID;
+
+@Service
+public class PaymentService {
+
+    private final PaymentRepository paymentRepository;
+    private final PaymentRefundRepository refundRepository;
+    private final PaymentMapper paymentMapper;
+    private final AuthContextResolver authContextResolver;
+
+    public PaymentService(PaymentRepository paymentRepository,
+                          PaymentRefundRepository refundRepository,
+                          PaymentMapper paymentMapper,
+                          AuthContextResolver authContextResolver) {
+        this.paymentRepository = paymentRepository;
+        this.refundRepository = refundRepository;
+        this.paymentMapper = paymentMapper;
+        this.authContextResolver = authContextResolver;
+    }
+
+    @Transactional
+    public PaymentResponse createPayment(PaymentCreateRequest request) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        ensureCustomerOrAdmin(user);
+
+        paymentRepository.findByOrderIdAndTenantId(request.orderId(), user.tenantId())
+                .ifPresent(existing -> { throw new ConflictException("Payment already exists for order"); });
+
+        PaymentEntity payment = new PaymentEntity();
+        payment.setOrderId(request.orderId());
+        payment.setCustomerId(user.userId());
+        payment.setTenantId(user.tenantId());
+        payment.setAmount(request.amount());
+        payment.setPaymentMethod(request.paymentMethod());
+        payment.setPaymentStatus(PaymentStatus.PROCESSING);
+        payment.setStatus(EntityStatus.ACTIVE);
+
+        PaymentEntity saved = paymentRepository.save(payment);
+        return paymentMapper.toResponse(saved, List.of());
+    }
+
+    @Transactional
+    public PaymentResponse updatePaymentStatus(UUID paymentId, PaymentStatusUpdateRequest request) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        if (!user.role().contains("ADMIN") && !user.role().contains("SYSTEM")) {
+            throw new ForbiddenException("Only admin/system can update payment status");
+        }
+
+        PaymentEntity payment = paymentRepository.findByIdAndTenantId(paymentId, user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Payment not found"));
+
+        payment.setPaymentStatus(request.status());
+        payment.setGatewayTransactionId(request.gatewayTransactionId());
+        payment.setFailureReason(request.failureReason());
+
+        PaymentEntity saved = paymentRepository.save(payment);
+        return paymentMapper.toResponse(saved, refundRepository.findByPaymentId(saved.getId()));
+    }
+
+    @Transactional
+    public RefundResponse refundPayment(UUID paymentId, RefundRequest request) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        if (!user.role().contains("ADMIN") && !user.role().contains("CUSTOMER")) {
+            throw new ForbiddenException("Only admin/customer can request refund");
+        }
+
+        PaymentEntity payment = paymentRepository.findByIdAndTenantId(paymentId, user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Payment not found"));
+
+        if (user.role().contains("CUSTOMER") && !payment.getCustomerId().equals(user.userId())) {
+            throw new ForbiddenException("Customer cannot refund someone else's payment");
+        }
+
+        if (!payment.getPaymentStatus().equals(PaymentStatus.SUCCESS)
+                && !payment.getPaymentStatus().equals(PaymentStatus.PARTIALLY_REFUNDED)) {
+            throw new ConflictException("Refund allowed only for successful payments");
+        }
+
+        BigDecimal remaining = payment.getAmount().subtract(payment.getRefundedAmount());
+        if (request.amount().compareTo(remaining) > 0) {
+            throw new ConflictException("Refund amount exceeds remaining paid amount");
+        }
+
+        PaymentRefundEntity refund = new PaymentRefundEntity();
+        refund.setPaymentId(payment.getId());
+        refund.setOrderId(payment.getOrderId());
+        refund.setTenantId(payment.getTenantId());
+        refund.setAmount(request.amount());
+        refund.setReason(request.reason());
+        refund.setGatewayRefundId("rfnd-" + UUID.randomUUID());
+        refund.setStatus(EntityStatus.ACTIVE);
+
+        PaymentRefundEntity savedRefund = refundRepository.save(refund);
+
+        payment.setRefundedAmount(payment.getRefundedAmount().add(request.amount()));
+        if (payment.getRefundedAmount().compareTo(payment.getAmount()) == 0) {
+            payment.setPaymentStatus(PaymentStatus.REFUNDED);
+        } else {
+            payment.setPaymentStatus(PaymentStatus.PARTIALLY_REFUNDED);
+        }
+        paymentRepository.save(payment);
+
+        return new RefundResponse(
+                savedRefund.getId(),
+                savedRefund.getPaymentId(),
+                savedRefund.getOrderId(),
+                savedRefund.getAmount(),
+                savedRefund.getReason(),
+                savedRefund.getGatewayRefundId()
+        );
+    }
+
+    @Transactional(readOnly = true)
+    public PaymentResponse getPaymentById(UUID paymentId) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        PaymentEntity payment = paymentRepository.findByIdAndTenantId(paymentId, user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Payment not found"));
+
+        if (!user.role().contains("ADMIN") && !payment.getCustomerId().equals(user.userId())) {
+            throw new ForbiddenException("Not allowed to view this payment");
+        }
+
+        return paymentMapper.toResponse(payment, refundRepository.findByPaymentId(paymentId));
+    }
+
+    @Transactional(readOnly = true)
+    public List<PaymentResponse> listMyPayments() {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        ensureCustomerOrAdmin(user);
+
+        List<PaymentEntity> payments;
+        if (user.role().contains("ADMIN")) {
+            payments = paymentRepository.findAll().stream().filter(p -> p.getTenantId().equals(user.tenantId())).toList();
+        } else {
+            payments = paymentRepository.findByTenantIdAndCustomerId(user.tenantId(), user.userId());
+        }
+
+        return payments.stream()
+                .map(p -> paymentMapper.toResponse(p, refundRepository.findByPaymentId(p.getId())))
+                .toList();
+    }
+
+    private void ensureCustomerOrAdmin(AuthenticatedUser user) {
+        if (!user.role().contains("CUSTOMER") && !user.role().contains("ADMIN")) {
+            throw new ForbiddenException("Customer or Admin role required");
+        }
+    }
+}
