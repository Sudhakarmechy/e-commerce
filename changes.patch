@@ -0,0 +1,134 @@
+package com.marketplace.service;
+
+import com.marketplace.dto.VendorLocationRequest;
+import com.marketplace.dto.VendorLocationResponse;
+import com.marketplace.dto.VendorResponse;
+import com.marketplace.dto.VendorUpsertRequest;
+import com.marketplace.entity.ApprovalStatus;
+import com.marketplace.entity.EntityStatus;
+import com.marketplace.entity.VendorEntity;
+import com.marketplace.entity.VendorLocationEntity;
+import com.marketplace.exception.ForbiddenException;
+import com.marketplace.exception.NotFoundException;
+import com.marketplace.mapper.VendorMapper;
+import com.marketplace.repository.VendorLocationRepository;
+import com.marketplace.repository.VendorRepository;
+import com.marketplace.util.AuthContextResolver;
+import com.marketplace.util.AuthenticatedUser;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.util.UUID;
+
+@Service
+public class VendorService {
+
+    private final VendorRepository vendorRepository;
+    private final VendorLocationRepository vendorLocationRepository;
+    private final VendorMapper vendorMapper;
+    private final AuthContextResolver authContextResolver;
+
+    public VendorService(VendorRepository vendorRepository,
+                         VendorLocationRepository vendorLocationRepository,
+                         VendorMapper vendorMapper,
+                         AuthContextResolver authContextResolver) {
+        this.vendorRepository = vendorRepository;
+        this.vendorLocationRepository = vendorLocationRepository;
+        this.vendorMapper = vendorMapper;
+        this.authContextResolver = authContextResolver;
+    }
+
+    @Transactional
+    public VendorResponse upsertMyVendor(VendorUpsertRequest request) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        ensureVendorRole(user);
+
+        VendorEntity vendor = vendorRepository.findByOwnerUserIdAndTenantId(user.userId(), user.tenantId())
+                .orElseGet(VendorEntity::new);
+
+        vendor.setOwnerUserId(user.userId());
+        vendor.setTenantId(user.tenantId());
+        vendor.setStoreName(request.storeName());
+        vendor.setDescription(request.description());
+        vendor.setContactPhone(request.contactPhone());
+        vendor.setOpeningHours(request.openingHours());
+        vendor.setStatus(EntityStatus.ACTIVE);
+        if (vendor.getApprovalStatus() == null) {
+            vendor.setApprovalStatus(ApprovalStatus.PENDING);
+        }
+
+        return vendorMapper.toResponse(vendorRepository.save(vendor));
+    }
+
+    @Transactional(readOnly = true)
+    public VendorResponse getMyVendor() {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        ensureVendorRole(user);
+
+        VendorEntity vendor = vendorRepository.findByOwnerUserIdAndTenantId(user.userId(), user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Vendor profile not found"));
+        return vendorMapper.toResponse(vendor);
+    }
+
+    @Transactional
+    public VendorLocationResponse upsertMyVendorLocation(VendorLocationRequest request) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        ensureVendorRole(user);
+
+        VendorEntity vendor = vendorRepository.findByOwnerUserIdAndTenantId(user.userId(), user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Vendor profile not found"));
+
+        VendorLocationEntity location = vendorLocationRepository.findByVendorIdAndTenantId(vendor.getId(), user.tenantId())
+                .orElseGet(VendorLocationEntity::new);
+
+        location.setVendorId(vendor.getId());
+        location.setTenantId(user.tenantId());
+        location.setAddressLine(request.addressLine());
+        location.setCity(request.city());
+        location.setState(request.state());
+        location.setPostalCode(request.postalCode());
+        location.setLatitude(request.latitude());
+        location.setLongitude(request.longitude());
+        location.setStatus(EntityStatus.ACTIVE);
+
+        return vendorMapper.toResponse(vendorLocationRepository.save(location));
+    }
+
+    @Transactional(readOnly = true)
+    public VendorLocationResponse getMyVendorLocation() {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        ensureVendorRole(user);
+
+        VendorEntity vendor = vendorRepository.findByOwnerUserIdAndTenantId(user.userId(), user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Vendor profile not found"));
+
+        VendorLocationEntity location = vendorLocationRepository.findByVendorIdAndTenantId(vendor.getId(), user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Vendor location not found"));
+        return vendorMapper.toResponse(location);
+    }
+
+    @Transactional
+    public void deactivateMyVendor() {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        ensureVendorRole(user);
+
+        VendorEntity vendor = vendorRepository.findByOwnerUserIdAndTenantId(user.userId(), user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Vendor profile not found"));
+        vendor.setStatus(EntityStatus.INACTIVE);
+        vendorRepository.save(vendor);
+    }
+
+    @Transactional(readOnly = true)
+    public VendorResponse getVendorById(UUID vendorId) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        VendorEntity vendor = vendorRepository.findByIdAndTenantId(vendorId, user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Vendor not found"));
+        return vendorMapper.toResponse(vendor);
+    }
+
+    private void ensureVendorRole(AuthenticatedUser user) {
+        if (!user.role().contains("VENDOR") && !user.role().contains("ADMIN")) {
+            throw new ForbiddenException("Vendor role is required");
+        }
+    }
+}
