diff --git a/notification-service/src/main/java/com/marketplace/service/NotificationService.java b/notification-service/src/main/java/com/marketplace/service/NotificationService.java
new file mode 100644
index 0000000000000000000000000000000000000000..46883af2839c065ce849cae4d55b9566833dae96
--- /dev/null
+++ b/notification-service/src/main/java/com/marketplace/service/NotificationService.java
@@ -0,0 +1,114 @@
+package com.marketplace.service;
+
+import com.marketplace.dto.NotificationCreateRequest;
+import com.marketplace.dto.NotificationResponse;
+import com.marketplace.dto.NotificationStatusUpdateRequest;
+import com.marketplace.entity.EntityStatus;
+import com.marketplace.entity.NotificationEntity;
+import com.marketplace.entity.NotificationStatus;
+import com.marketplace.exception.ForbiddenException;
+import com.marketplace.exception.NotFoundException;
+import com.marketplace.mapper.NotificationMapper;
+import com.marketplace.repository.NotificationRepository;
+import com.marketplace.util.AuthContextResolver;
+import com.marketplace.util.AuthenticatedUser;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.time.OffsetDateTime;
+import java.util.List;
+import java.util.UUID;
+
+@Service
+public class NotificationService {
+
+    private final NotificationRepository notificationRepository;
+    private final NotificationMapper mapper;
+    private final AuthContextResolver authContextResolver;
+
+    public NotificationService(NotificationRepository notificationRepository,
+                               NotificationMapper mapper,
+                               AuthContextResolver authContextResolver) {
+        this.notificationRepository = notificationRepository;
+        this.mapper = mapper;
+        this.authContextResolver = authContextResolver;
+    }
+
+    @Transactional
+    public NotificationResponse createNotification(NotificationCreateRequest request) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        if (!user.role().contains("ADMIN") && !user.role().contains("SYSTEM") && !user.role().contains("VENDOR")) {
+            throw new ForbiddenException("Only admin/system/vendor can create notifications");
+        }
+
+        NotificationEntity n = new NotificationEntity();
+        n.setTenantId(user.tenantId());
+        n.setRecipientUserId(request.recipientUserId());
+        n.setChannel(request.channel());
+        n.setSubject(request.subject());
+        n.setMessage(request.message());
+        n.setReferenceType(request.referenceType());
+        n.setReferenceId(request.referenceId());
+        n.setNotificationStatus(NotificationStatus.PENDING);
+        n.setStatus(EntityStatus.ACTIVE);
+
+        NotificationEntity saved = notificationRepository.save(n);
+        return mapper.toResponse(saved);
+    }
+
+    @Transactional
+    public NotificationResponse updateStatus(UUID notificationId, NotificationStatusUpdateRequest request) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        NotificationEntity n = notificationRepository.findByIdAndTenantId(notificationId, user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Notification not found"));
+
+        boolean admin = user.role().contains("ADMIN") || user.role().contains("SYSTEM");
+        boolean owner = n.getRecipientUserId().equals(user.userId());
+
+        if (!admin && !owner) throw new ForbiddenException("Not allowed to update this notification");
+
+        n.setNotificationStatus(request.status());
+        n.setFailureReason(request.failureReason());
+        if (request.status() == NotificationStatus.SENT) {
+            n.setSentAt(OffsetDateTime.now());
+        }
+        if (request.status() == NotificationStatus.READ) {
+            n.setReadAt(OffsetDateTime.now());
+        }
+
+        return mapper.toResponse(notificationRepository.save(n));
+    }
+
+    @Transactional(readOnly = true)
+    public NotificationResponse getById(UUID notificationId) {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        NotificationEntity n = notificationRepository.findByIdAndTenantId(notificationId, user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Notification not found"));
+
+        boolean admin = user.role().contains("ADMIN") || user.role().contains("SYSTEM");
+        boolean owner = n.getRecipientUserId().equals(user.userId());
+        if (!admin && !owner) throw new ForbiddenException("Not allowed to access this notification");
+
+        return mapper.toResponse(n);
+    }
+
+    @Transactional(readOnly = true)
+    public List<NotificationResponse> listMyNotifications() {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        return notificationRepository.findByTenantIdAndRecipientUserIdOrderByCreatedAtDesc(user.tenantId(), user.userId())
+                .stream().map(mapper::toResponse).toList();
+    }
+
+    @Transactional(readOnly = true)
+    public List<NotificationResponse> listTenantNotifications() {
+        AuthenticatedUser user = authContextResolver.currentUser();
+        if (!user.role().contains("ADMIN") && !user.role().contains("SYSTEM")) {
+            throw new ForbiddenException("Only admin/system can list tenant notifications");
+        }
+
+        return notificationRepository.findAll().stream()
+                .filter(n -> n.getTenantId().equals(user.tenantId()))
+                .map(mapper::toResponse)
+                .toList();
+    }
+}
